node_modules/
# Runtime state (which wall is active), and the old single-wall layout.
/data/
/media/
# Per wall: calibration and media live on the box, not in git.
walls/*/calibration*.json
walls/*/*.tmp
walls/*/media/*
!walls/*/media/.gitkeep
# Reference images belong to the wall definition, so they are in git.
!walls/*/media/reference.*
!walls/*/media/spotlight.*
